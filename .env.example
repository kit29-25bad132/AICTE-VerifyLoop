# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose maps POSTGRES_PORT on the host)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verifyloop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verifyloop?schema=public

# Redis / BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Document storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800

# AI providers (fallback order: Gemini -> Groq -> OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aicte-verifyloop

# Python PyMuPDF parser service (subprocess CLI by default)
PYTHON_BIN=python
PARSER_SCRIPT=workers/parser-service/main.py
