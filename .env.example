# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose maps POSTGRES_PORT on the host)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verifyloop
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/verifyloop?schema=public

# Redis / BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Document storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800

# Gemini is the only AI provider currently wired into the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Reserved for provider integrations not currently wired into the server.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LangSmith tracing is not currently wired into the server.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=verifyloop-sih2026
ORCHESTRATOR_SERVICE_URL=http://localhost:8001
